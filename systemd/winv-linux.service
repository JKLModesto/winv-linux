[Unit]
Description=winv-linux - Windows Win+V Clipboard History Daemon for Linux
Documentation=https://github.com/pedro/winv-linux

[Service]
Type=simple
ExecStart=%h/.local/bin/winv-linux --daemon
Restart=on-failure
RestartSec=2s
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/.local/share/winv-linux

[Install]
WantedBy=default.target
